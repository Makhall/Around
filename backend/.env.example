# Local development against the Firebase Emulator Suite.
# Copy to .env and adjust if your emulator hosts differ.
FIREBASE_PROJECT_ID=around-847b3
FIREBASE_DATABASE_URL=https://around-847b3-default-rtdb.asia-southeast1.firebasedatabase.app
# Optional: RTDB emulator namespace. Defaults to the first host segment of FIREBASE_DATABASE_URL.
# FIREBASE_DATABASE_INSTANCE=around-847b3-default-rtdb
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
PORT=3000

# Production only (set these in Vercel, never commit them):
# FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 of the service account JSON>
