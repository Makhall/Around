rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function isMember(circleId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/circles/$(circleId)/members/$(currentUid()));
    }

    function isOwner(circleId) {
      return isMember(circleId) &&
        get(/databases/$(database)/documents/circles/$(circleId)/members/$(currentUid())).data.role == 'owner';
    }

    function validAvatar(data) {
      return data is map &&
        data.type in ['emoji', 'color'] &&
        data.value is string &&
        data.value.size() >= 1 &&
        data.value.size() <= 8;
    }

    function validDisplayName(value) {
      return value is string && value.size() >= 1 && value.size() <= 30;
    }

    function validPlaceData(data) {
      return data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 40 &&
        data.radiusM is number &&
        data.radiusM >= 100 &&
        data.radiusM <= 1000 &&
        data.lat is number &&
        data.lng is number;
    }

    match /users/{userId} {
      allow read: if signedIn() && currentUid() == userId;
      allow create, update: if signedIn() &&
        currentUid() == userId &&
        validDisplayName(request.resource.data.displayName) &&
        validAvatar(request.resource.data.avatar);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, write: if signedIn() && currentUid() == userId;
      }
    }

    match /circles/{circleId} {
      // memberUids keeps list queries (whereArrayContains) rule-friendly.
      allow read: if signedIn() &&
        (currentUid() in resource.data.memberUids || isMember(circleId));
      allow write: if false;

      match /members/{memberUid} {
        allow read: if isMember(circleId);
        allow update: if signedIn() &&
          currentUid() == memberUid &&
          isMember(circleId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'avatar', 'sharing', 'historyEnabled', 'placeAlerts', 'allowRing']) &&
          validDisplayName(request.resource.data.displayName) &&
          validAvatar(request.resource.data.avatar) &&
          (!('sharing' in request.resource.data.diff(resource.data).affectedKeys()) ||
            request.resource.data.sharing is bool) &&
          (!('historyEnabled' in request.resource.data.diff(resource.data).affectedKeys()) ||
            request.resource.data.historyEnabled is bool) &&
          (!('placeAlerts' in request.resource.data.diff(resource.data).affectedKeys()) ||
            request.resource.data.placeAlerts is bool) &&
          (!('allowRing' in request.resource.data.diff(resource.data).affectedKeys()) ||
            request.resource.data.allowRing is bool);
        allow create, delete: if false;
      }

      match /places/{placeId} {
        allow read: if isMember(circleId);
        allow create: if isMember(circleId) &&
          request.resource.data.createdBy == currentUid() &&
          validPlaceData(request.resource.data);
        allow update: if (isOwner(circleId) ||
          (isMember(circleId) && resource.data.createdBy == currentUid())) &&
          validPlaceData(request.resource.data) &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'lat', 'lng', 'radiusM']);
        allow delete: if isOwner(circleId) ||
          (isMember(circleId) && resource.data.createdBy == currentUid());
      }

      match /events/{eventId} {
        allow read: if isMember(circleId);
        allow write: if false;
      }
    }

    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    match /userSecrets/{userId} {
      allow read, write: if false;
    }

    match /joinAttempts/{userId} {
      allow read, write: if false;
    }
  }
}
